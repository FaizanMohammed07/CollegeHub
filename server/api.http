###############################################
# College Hub - Complete API Testing Guide
# Use with REST Client extension (VS Code)
# Install: ext install humao.rest-client
###############################################

@baseUrl = http://localhost:4000
@contentType = application/json

###############################################
# IMPORTANT: ROLE-BASED ACCESS CONTROL
###############################################
# 
# INSUFFICIENT_ROLE Error Solution:
# 
# The error "This action requires one of the following roles: 
# club_admin, college_admin, super_admin" means the user
# account doesn't have the required role to create clubs.
#
# ROLES AVAILABLE:
# - student (default) → Can register for events, join clubs
# - club_admin → Can create/manage clubs
# - college_admin → Can manage college and clubs
# - super_admin → Full access (created via database)
#
# WORKAROUND FOR TESTING:
# 1. Use the seeded admin account: admin@collegehub.com
# 2. Or manually update user role in MongoDB
# 3. Or modify schemas to allow students to create clubs
#
###############################################

###############################################
# SEEDED TEST ACCOUNTS (from npm run seed)
###############################################

### ⭐ LOGIN - College Admin (can create clubs)
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "admin@stanford.edu",
  "password": "SecurePass123@"
}

###############################################

### LOGIN - Club Admin (can create clubs)
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "diana@berkeley.edu",
  "password": "SecurePass123@"
}

###############################################

### LOGIN - Student Account (cannot create clubs)
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "alice@stanford.edu",
  "password": "SecurePass123@"
}

###############################################

###############################################
# AUTHENTICATION ENDPOINTS
###############################################

### 1. Health Check
GET {{baseUrl}}/health

###############################################

### 2. Signup - Create New User
POST {{baseUrl}}/api/auth/signup
Content-Type: {{contentType}}

{
  "name": "John Doe",
  "email": "john@example.com",
  "password": "SecurePass123@"
}

###############################################

### 3. Login - Get Access Token
POST http://localhost:4000/api/auth/login
Content-Type:  application/json

{
  "email": "john@example.com",
  "password": "SecurePass123@"
}

###############################################

### 4. Refresh Token - Get New Access Token
POST {{baseUrl}}/api/auth/refresh
Content-Type: {{contentType}}

{
  "refreshToken": "your-refresh-token-here"
}

###############################################

### 5. Logout - Revoke Token
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer your-access-token-here
Content-Type: {{contentType}}

{}

###############################################

### 6. Forgot Password - Request Reset
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: {{contentType}}

{
  "email": "john@example.com"
}

###############################################

### 7. Reset Password - Set New Password
POST {{baseUrl}}/api/auth/reset-password
Content-Type: {{contentType}}

{
  "token": "reset-token-from-email",
  "password": "NewSecurePass456@"
}

###############################################

### 8. Request Email Verification
POST {{baseUrl}}/api/auth/request-verification
Authorization: Bearer your-access-token-here
Content-Type: {{contentType}}

{}

###############################################

### 9. Verify Email - Complete Verification
POST {{baseUrl}}/api/auth/verify-email
Content-Type: {{contentType}}

{
  "token": "verification-token-from-email"
}

###############################################
# USER ENDPOINTS
###############################################

### 10. Get Current Profile
GET {{baseUrl}}/api/users/me
Authorization: Bearer your-access-token-here

###############################################

### 11. Update Profile
