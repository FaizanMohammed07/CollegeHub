  "name": "John Smith",
  "phone": "+1-555-0123",
  "profilePicUrl": "https://example.com/pic.jpg"
}

###############################################

### 12. Update Location
PUT {{baseUrl}}/api/users/me/location
Authorization: Bearer your-access-token-here
