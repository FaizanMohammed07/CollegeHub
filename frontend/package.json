{
  "name": "college-hub-frontend",
  "version": "1.0.0",
  "description": "Production-grade College Hub React frontend",
  "private": true,
  "type": "module",
  "homepage": "http://localhost:3000",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "axios": "^1.6.0",
    "framer-motion": "^10.16.0",
    "zustand": "^4.4.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "geolocation-utils": "^1.2.6",
    "mapbox-gl": "^2.15.0",
    "react-icons": "^4.12.0",
    "react-hot-toast": "^2.4.0",
    "react-hook-form": "^7.48.0",
    "query-string": "^8.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "vite": "^5.0.0",
    "typescript": "^5.3.0",
    "eslint": "^8.55.0",
    "eslint-config-react-app": "^7.0.0",
    "prettier": "^3.1.0",
    "vitest": "^1.0.0",
    "@vitest/ui": "^1.0.0"
  }
}
