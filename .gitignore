docker-compose.override.yml

# Mac Finder
.AppleDouble
.LSOverride

# VS Code test
.vscode-test/

# Ignore generated lock files only if you prefer (commented out)
# package-lock.json
# yarn.lock

# Ignore local secrets and keys
**/*.key
**/*.pem

# Ignore IDE workspace files
*.code-workspace

# Ignore build artifacts from various frameworks
out/
.build/

# Keep Git from checking in large binaries (uncomment if you store any)
# *.exe
# *.dll

